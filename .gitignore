# deps / build
node_modules/
.next/

# secrets
.env
.env.*
# ...but NOT the template. `.env.*` was swallowing .env.example, so the only
# documentation of which env vars exist (Drive OAuth, YouTube OAuth, Resend)
# never reached the repo — a fresh clone or a rebuilt droplet had nothing to
# copy from. It contains names and comments only, never values.
!.env.example

# runtime data — live DB and served media stay out of git.
# app/public/media/ also covers what the Shorts pipeline writes: each game's
# retained game.json and the rendered shorts/ clips.
app/data/
app/public/media/
*.log

# large artifacts
*.mp4
# ...but the hero plate is brand content, not game media. It's baked into the
# page rather than imported at runtime, so a fresh clone that lacks it renders
# a still hero and no one notices the asset is missing.
!app/public/brand/hero.mp4
*.zip
pipeline/rally_clips/
# model weights: ultralytics downloads yolo*.pt into the working directory on
# first use, and the bootstrapped ball_model.pt is regenerable from the video.
*.pt

# python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
# written by `pip install -e pipeline` (local GPU setup, see pipeline/README.md)
*.egg-info/

# OS
.DS_Store
Thumbs.db
