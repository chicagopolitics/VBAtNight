# Optional — without it, magic links are printed to the server console (dev mode)
RESEND_API_KEY=
MAIL_FROM="Balltime <onboarding@resend.dev>"
# Comma-separated organizer emails. UNSET = everyone is organizer (dev only!)
ORGANIZER_EMAILS=christianson.general@gmail.com
# Public URL used in magic links (default: request origin)
APP_URL=
# --- YouTube delivery (see YOUTUBE-PLAN.md) ---
# Separate OAuth client from the Drive one. Get the refresh token with
# `npm run yt-auth`, then prove uploads aren't locked private: `npm run yt-probe`.
# Unset = the app still works; "Link a manual upload" needs no credentials.
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REFRESH_TOKEN=
YT_PRIVACY=unlisted
